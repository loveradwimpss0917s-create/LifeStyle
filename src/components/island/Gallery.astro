---
/**
 * Gallery — 06章§6.5(island)
 * メイン画像+サムネ列。サムネクリックでメイン切替(フェード200ms)。
 * JS不可時: 全画像縦積み表示にフォールバック(CSSで既定は全表示、JSが `.gallery--enhanced`
 * を付与したときのみ1枚表示+サムネ切替に切り替わるprogressive enhancement)。
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const images = product.data.images;
// コンテナの高さは「一番縦長の写真」がちょうど収まる比率に固定する(縦横比が
// 最小=最も縦長のものを採用)。これにより、どの写真に切り替えてもコンテナの
// 高さ自体が変わらず、ページのどの部分もまったく動かない。横長寄りの写真は
// 自然な大きさのまま縦方向中央に表示され、余った分は特別な装飾を足さず
// ページの背景色のままにする(トリミングも引き伸ばしもしない)。
const containerAspectRatio = Math.min(...images.map((img) => img.src.width / img.src.height));
---

<div class="gallery" data-gallery>
  <div class="gallery__main" style={`--gallery-aspect-ratio: ${containerAspectRatio}`}>
    {images.map((img, index) => (
      <div
        class:list={['gallery__main-item', { 'is-active': index === 0 }]}
        data-gallery-main
        data-index={index}
      >
        <Image
          src={img.src}
          alt={img.alt}
          width={800}
          widths={[480, 640, 960, 1280]}
          sizes="(min-width: 768px) 640px, calc(100vw - 40px)"
          class="gallery__main-image"
          loading={index === 0 ? 'eager' : 'lazy'}
          priority={index === 0}
          transition:name={index === 0 ? `product-image-${product.id}` : undefined}
        />
      </div>
    ))}
  </div>
  {images.length > 1 && (
    <div class="gallery__thumbs">
      {images.map((img, index) => (
        <button
          type="button"
          class:list={['gallery__thumb', { 'is-active': index === 0 }]}
          data-gallery-thumb
          data-index={index}
          aria-label={`${index + 1}枚目の画像を表示`}
          aria-pressed={index === 0}
        >
          <Image src={img.src} alt="" width={120} height={150} loading="eager" />
        </button>
      ))}
    </div>
  )}
</div>

<style>
  /*
   * 実バグ修正: 商品画像は撮影写真ごとに縦横比がまちまちなため、サムネ切替時に
   * .gallery__mainの高さがそのつど画像の縦横比に合わせて変わり、ページ全体が
   * ガタつく(表示が上下する)不具合があった。以前はコンテナの高さを毎回
   * アニメーションさせて対応していたが、写真の縦横比の振れ幅が大きい商品では
   * その動き自体が気になるとの指摘を受け、根本的に「動かない」方式に変更した。
   * コンテナの高さは一番縦長の写真(frontmatter側でcontainerAspectRatioとして
   * 算出済み)に合わせて固定し、どの写真に切り替えてもコンテナ自体のサイズは
   * 一切変わらない。それより横長寄りの写真は自然な大きさのまま縦中央に表示し、
   * 余った分は装飾を足さずページの背景色のままにする(トリミングも
   * 引き伸ばしもしない)。
   */
  .gallery--enhanced .gallery__main {
    position: relative;
    aspect-ratio: var(--gallery-aspect-ratio, auto);
  }

  .gallery__main-item {
    width: 100%;
    margin-bottom: var(--space-3);
  }

  .gallery--enhanced .gallery__main-item {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    margin-bottom: 0;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .gallery--enhanced .gallery__main-item.is-active {
    display: flex;
    opacity: 1;
  }

  .gallery__main-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .gallery__thumbs {
    display: none;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .gallery--enhanced .gallery__thumbs {
    display: flex;
  }

  .gallery__thumb {
    width: 64px;
    height: 80px;
    overflow: hidden;
    opacity: 0.6;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__thumb.is-active,
  .gallery__thumb:hover {
    opacity: 1;
  }
</style>

<script is:inline data-astro-rerun>
  // data-astro-rerun: View Transitions遷移後もGallery要素を再取得・再アタッチするために必須
  // IIFEで包む: data-astro-rerunで同じスクリプトが再実行された際、トップレベルの
  // const/letはグローバルスコープで再宣言エラーになるため関数スコープに閉じ込める。
  (function () {
    const galleries = document.querySelectorAll('[data-gallery]');

    for (const gallery of galleries) {
      const mains = gallery.querySelectorAll('[data-gallery-main]');
      const thumbs = gallery.querySelectorAll('[data-gallery-thumb]');
      if (mains.length <= 1) continue;

      // 初期描画直後にdisplay/opacityを変えるレイアウト変化を起こすと、
      // LCP計測対象が不安定なサムネイル要素に誤って固定されることを実測で確認した。
      // そのためLCPが確定してから見た目を切り替えるよう、初期描画後まで遅延させる。
      const enhance = () => gallery.classList.add('gallery--enhanced');
      if ('requestIdleCallback' in window) {
        requestIdleCallback(enhance, { timeout: 2000 });
      } else {
        setTimeout(enhance, 0);
      }

      for (const thumb of thumbs) {
        thumb.addEventListener('click', () => {
          const index = thumb.dataset.index;
          for (const main of mains) {
            main.classList.toggle('is-active', main.dataset.index === index);
          }
          for (const t of thumbs) {
            t.classList.toggle('is-active', t === thumb);
            t.setAttribute('aria-pressed', String(t === thumb));
          }
        });
      }
    }
  })();
</script>
