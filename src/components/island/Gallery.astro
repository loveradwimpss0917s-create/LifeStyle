---
/**
 * Gallery — 06章§6.5(island)
 * メイン画像+サムネ列。サムネクリックでメイン切替(フェード200ms)。
 * JS不可時: 全画像縦積み表示にフォールバック(CSSで既定は全表示、JSが `.gallery--enhanced`
 * を付与したときのみ1枚表示+サムネ切替に切り替わるprogressive enhancement)。
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const images = product.data.images;
const initialAspectRatio = `${images[0].src.width} / ${images[0].src.height}`;
---

<div class="gallery" data-gallery>
  <div class="gallery__main" data-gallery-box style={`--initial-aspect-ratio: ${initialAspectRatio}`}>
    {images.map((img, index) => (
      <div
        class:list={['gallery__main-item', { 'is-active': index === 0 }]}
        data-gallery-main
        data-index={index}
        data-width={img.src.width}
        data-height={img.src.height}
      >
        <Image
          src={img.src}
          alt={img.alt}
          width={800}
          densities={[1, 2]}
          class="gallery__main-image"
          loading={index === 0 ? 'eager' : 'lazy'}
          priority={index === 0}
          transition:name={index === 0 ? `product-image-${product.id}` : undefined}
        />
      </div>
    ))}
  </div>
  {images.length > 1 && (
    <div class="gallery__thumbs">
      {images.map((img, index) => (
        <button
          type="button"
          class:list={['gallery__thumb', { 'is-active': index === 0 }]}
          data-gallery-thumb
          data-index={index}
          aria-label={`${index + 1}枚目の画像を表示`}
          aria-pressed={index === 0}
        >
          <Image src={img.src} alt="" width={120} height={150} loading="eager" />
        </button>
      ))}
    </div>
  )}
</div>

<style>
  /*
   * 実バグ修正: 商品画像は撮影写真ごとに縦横比がまちまちなため、サムネ切替時に
   * .gallery__mainの高さがそのつど画像の縦横比に合わせて変わり、ページ全体が
   * ガタつく(表示が上下する)不具合があった。写真はトリミングも背景ぼかしも
   * 入れず自然な縦横比のまま表示する方針のため、固定aspect-ratioや余白埋めの
   * 背景では対応できない。代わりに、コンテナの初期aspect-ratioを最初の画像の
   * 実寸(--initial-aspect-ratio、サーバー側で既知)に合わせて初回表示時のCLSを
   * 防ぎつつ、サムネ切替時はJS(下部script)でコンテナの高さを現在値→次の画像の
   * 実寸比に基づく高さへアニメーションさせ、ページ全体が瞬時にガタつかない
   * ようにしている(アニメーション完了後にaspect-ratioへ戻し、リサイズにも
   * 追従できるようにする)。
   */
  .gallery--enhanced .gallery__main {
    position: relative;
    aspect-ratio: var(--initial-aspect-ratio, auto);
    overflow: hidden;
  }

  .gallery__main-item {
    width: 100%;
    margin-bottom: var(--space-3);
  }

  .gallery--enhanced .gallery__main-item {
    display: none;
    position: absolute;
    inset: 0;
    margin-bottom: 0;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .gallery--enhanced .gallery__main-item.is-active {
    display: block;
    opacity: 1;
  }

  .gallery__main-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .gallery--enhanced .gallery__main-image {
    width: 100%;
    height: 100%;
    /*
     * コンテナは常にアクティブな画像の実寸比に揃っているため、静止状態では
     * object-fitの指定は結果に影響しない(トリミングは発生しない)。
     * 高さアニメーション中の一時的な不一致でのみ、画像全体を欠けさせずに
     * 収めるために効く。
     */
    object-fit: contain;
  }

  .gallery__thumbs {
    display: none;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .gallery--enhanced .gallery__thumbs {
    display: flex;
  }

  .gallery__thumb {
    width: 64px;
    height: 80px;
    overflow: hidden;
    opacity: 0.6;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__thumb.is-active,
  .gallery__thumb:hover {
    opacity: 1;
  }
</style>

<script is:inline data-astro-rerun>
  // data-astro-rerun: View Transitions遷移後もGallery要素を再取得・再アタッチするために必須
  // IIFEで包む: data-astro-rerunで同じスクリプトが再実行された際、トップレベルの
  // const/letはグローバルスコープで再宣言エラーになるため関数スコープに閉じ込める。
  (function () {
    const galleries = document.querySelectorAll('[data-gallery]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    for (const gallery of galleries) {
      const box = gallery.querySelector('[data-gallery-box]');
      const mains = gallery.querySelectorAll('[data-gallery-main]');
      const thumbs = gallery.querySelectorAll('[data-gallery-thumb]');
      if (mains.length <= 1) continue;

      // 初期描画直後にdisplay/opacityを変えるレイアウト変化を起こすと、
      // LCP計測対象が不安定なサムネイル要素に誤って固定されることを実測で確認した。
      // そのためLCPが確定してから見た目を切り替えるよう、初期描画後まで遅延させる。
      const enhance = () => gallery.classList.add('gallery--enhanced');
      if ('requestIdleCallback' in window) {
        requestIdleCallback(enhance, { timeout: 2000 });
      } else {
        setTimeout(enhance, 0);
      }

      for (const thumb of thumbs) {
        thumb.addEventListener('click', () => {
          const index = thumb.dataset.index;
          const targetItem = gallery.querySelector('[data-gallery-main][data-index="' + index + '"]');

          if (box && targetItem) {
            const targetW = Number(targetItem.dataset.width);
            const targetH = Number(targetItem.dataset.height);

            if (targetW && targetH) {
              if (prefersReducedMotion) {
                box.style.aspectRatio = targetW + ' / ' + targetH;
              } else {
                const startHeight = box.getBoundingClientRect().height;
                box.style.transition = '';
                box.style.aspectRatio = 'auto';
                box.style.height = startHeight + 'px';
                // 強制リフローで上記の高さを確定させてからtransitionを効かせる
                void box.offsetHeight;

                const targetHeight = box.clientWidth * (targetH / targetW);
                box.style.transition = 'height 260ms var(--ease-out, ease-out)';
                box.style.height = targetHeight + 'px';

                box.addEventListener(
                  'transitionend',
                  function onEnd(event) {
                    if (event.propertyName !== 'height') return;
                    box.removeEventListener('transitionend', onEnd);
                    box.style.transition = '';
                    box.style.height = '';
                    box.style.aspectRatio = targetW + ' / ' + targetH;
                  },
                  { once: true }
                );
              }
            }
          }

          for (const main of mains) {
            main.classList.toggle('is-active', main.dataset.index === index);
          }
          for (const t of thumbs) {
            t.classList.toggle('is-active', t === thumb);
            t.setAttribute('aria-pressed', String(t === thumb));
          }
        });
      }
    }
  })();
</script>
