---
/**
 * CategoryCard — 06章§6.3
 * Props: category。写真+英字名(Cormorant)+和名。hover: scale。
 */
import FramedImage from '@/components/base/FramedImage.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  category: CollectionEntry<'categories'>;
}

const { category } = Astro.props;
---

<a href={`/categories/${category.id}/`} class="category-card">
  <div class="category-card__media">
    <FramedImage
      src={category.data.image}
      alt={category.data.imageAlt}
      width={480}
      class="category-card__image"
    />
  </div>
  <div class="category-card__body">
    <p class="category-card__en">{category.data.nameEn}</p>
    <p class="category-card__ja">{category.data.nameJa}</p>
  </div>
</a>

<style>
  .category-card {
    display: block;
    transition: transform 100ms var(--ease-out);
  }

  /* 18章§2.5のタップ手応え */
  .category-card:active {
    transform: scale(0.98);
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card:active {
      transform: none;
    }
  }

  .category-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-secondary);
  }

  .category-card__image :global(.framed-image__fg) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .category-card:hover .category-card__image :global(.framed-image__fg) {
    transform: scale(1.02);
  }

  .category-card__body {
    margin-top: var(--space-3);
  }

  .category-card__en {
    font-family: var(--font-en);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink);
  }

  .category-card__ja {
    margin-top: 2px;
    font-size: var(--text-sm);
    color: var(--color-ink-tertiary);
  }
</style>
