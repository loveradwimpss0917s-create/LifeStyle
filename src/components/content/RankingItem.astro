---
/**
 * RankingItem — 06章§6.3
 * Props: rank, product(解決済みエントリ), comment?
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import RatingStars from '@/components/base/RatingStars.astro';
import { getArticlesForProduct } from '@/lib/product-index';

interface Props {
  rank: number;
  product: CollectionEntry<'products'>;
  comment?: string;
  compact?: boolean;
}

const { rank, product, comment, compact = false } = Astro.props;
const articles = await getArticlesForProduct(product.id);
const articleHref = articles.length > 0 ? `/articles/${articles[0].id}/` : null;
---

<div class:list={['ranking-item', { 'ranking-item--compact': compact }]} id={`rank-${rank}`}>
  <span class="ranking-item__rank">{rank}</span>
  <span class="ranking-item__image">
    <Image
      src={product.data.images[0].src}
      alt={product.data.images[0].alt}
      width={compact ? 80 : 160}
      densities={[1, 2]}
    />
  </span>
  <div class="ranking-item__body">
    <p class="ranking-item__name">
      <a href={`/products/${product.id}/`}>{product.data.name}</a>
    </p>
    <RatingStars rating={product.data.rating} />
    {comment && <p class="ranking-item__comment">{comment}</p>}
    {articleHref && (
      <a class="ranking-item__article-link" href={articleHref}>使ってみた感想を読む</a>
    )}
  </div>
</div>

<style>
  .ranking-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--border-thin);
  }

  .ranking-item__rank {
    flex-shrink: 0;
    width: 2.2em;
    font-family: var(--font-en);
    font-size: var(--text-2xl);
    color: var(--color-accent);
    text-align: center;
  }

  .ranking-item--compact .ranking-item__rank {
    font-size: var(--text-lg);
  }

  .ranking-item__image {
    display: block;
    flex-shrink: 0;
    width: 80px;
  }

  .ranking-item__image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ranking-item--compact .ranking-item__image {
    width: 48px;
  }

  .ranking-item__name a {
    font-weight: 500;
    color: var(--color-ink);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  @media (max-width: 767px) {
    .ranking-item {
      gap: var(--space-3);
    }

    .ranking-item__rank {
      width: 1.6em;
      font-size: var(--text-xl);
    }

    .ranking-item__image {
      width: 64px;
    }

    /* 狭い幅ではkeep-allだと先頭の単語だけが1行を占有し行数が増えるため、
       通常の折り返しに切り替えて行を均等に詰める */
    .ranking-item__name a {
      word-break: normal;
      overflow-wrap: anywhere;
    }
  }

  .ranking-item__comment {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
  }

  .ranking-item__article-link {
    position: relative;
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
    border-bottom: var(--border-thin);
  }

  /* 見た目は変えず、タップ領域だけを高さ44px相当に拡張する
     (実測で高さ28pxしかなくモバイルの推奨タップサイズを下回っていた・docs/33 §4-6)。
     FavoriteButton--sm と同じ手法。 */
  .ranking-item__article-link::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 44px;
    transform: translateY(-50%);
  }
</style>
