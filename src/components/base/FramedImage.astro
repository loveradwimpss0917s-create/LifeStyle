---
/**
 * FramedImage — 06章共通
 * 写真をアスペクト比固定の枠(呼び出し側のラッパー要素で aspect-ratio +
 * overflow:hidden を指定する)にノートリミングで収める汎用コンポーネント。
 *
 * 出典: Gallery.astro(商品ギャラリー)で先に採用したパターンをここに切り出した。
 * カード類がobject-fit:coverで写真を機械的にトリミングしていたところ、
 * 「提供した写真は全体表示されるようにして。トリミング無し」という指摘が
 * あったため、サイト内の全ての実写真表示箇所をこのコンポーネントに統一する。
 *
 * 枠の余白(containで生じる)は同じ写真を大きくぼかして敷いた背景で埋める
 * (単色の余白は見栄えが良くないという指摘のため)。ぼかし用画像は極小
 * サイズ(width=40)で十分なため、転送量はほぼ増えない。
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  densities?: number[];
  loading?: 'eager' | 'lazy';
  priority?: boolean;
  transitionName?: string;
  class?: string;
}

const {
  src,
  alt,
  width,
  densities = [1, 2],
  loading = 'lazy',
  priority = false,
  transitionName,
  class: className,
} = Astro.props;
---

<span class:list={['framed-image', className]}>
  <Image src={src} alt="" aria-hidden="true" width={40} class="framed-image__bg" loading={loading} />
  <Image
    src={src}
    alt={alt}
    width={width}
    densities={densities}
    class="framed-image__fg"
    loading={loading}
    priority={priority}
    transition:name={transitionName}
  />
</span>

<style>
  .framed-image {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .framed-image__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(24px) brightness(0.92);
    transform: scale(1.15);
  }

  .framed-image__fg {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
