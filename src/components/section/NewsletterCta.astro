---
/**
 * NewsletterCta — 26章c24(00章P-12・12章§6からV3で繰り延べ実装)
 *
 * 実バグ修正の経緯: ①最初はButtondownの埋め込みフォームAPIへ直接POSTし、
 * target="_blank"で確認画面を別タブに開いていたが、英語表記で訪問者の
 * 不安を煽る・タブを閉じる手間が増えるとの指摘があった。②非表示iframeへ
 * 送信してその場に日本語メッセージを出す方式を試したが、実際の送信結果を
 * 確認する手段がなく、未登録なのに画面上は成功したように見える不具合に
 * なった。③最終的に、フォームは同一オリジンの/newsletter/subscribe(Pages
 * Function)へPOSTし、そこでButtondown公式APIへサーバー側から登録・
 * 成否確認したうえでトップページへ結果(?newsletter=success|already|error)
 * 付きでリダイレクトする方式にした。新しいタブは開かず、英語画面も
 * 一切表示されず、かつ実際の成否に基づいた日本語メッセージを表示できる。
 *
 * 表示するsite.jsonのnewsletterUrlは、この機能を使うかどうかのフラグとして
 * のみ使う(未設定の場合はAstro側でセクションごと出し分ける)。実際の登録
 * 処理はBUTTONDOWN_API_KEY(Cloudflare Pagesの環境変数)を使って
 * functions/newsletter/subscribe.tsが行う。
 */
---

<section class="newsletter-cta" id="newsletter" data-newsletter>
  <div class="container-text newsletter-cta__inner">
    <p class="newsletter-cta__heading">メールでも、少しだけ。</p>
    <p class="newsletter-cta__lead">新しい記事やおすすめ商品を、月に数回ほどメールでお届けします。</p>
    <form action="/newsletter/subscribe" method="post" class="newsletter-cta__form" data-newsletter-form>
      <label for="newsletter-email" class="visually-hidden">メールアドレス</label>
      <input type="email" name="email" id="newsletter-email" placeholder="メールアドレス" required class="newsletter-cta__input" />
      <button type="submit" class="newsletter-cta__submit">登録する</button>
    </form>
    <p class="newsletter-cta__message" data-newsletter-message hidden aria-live="polite"></p>
  </div>
</section>

<style>
  .container-text {
    max-width: var(--container-text);
    margin-inline: auto;
    padding-inline: var(--outer-margin-mobile);
  }

  @media (min-width: 768px) {
    .container-text {
      padding-inline: var(--outer-margin);
    }
  }

  .newsletter-cta {
    padding-block: var(--space-7);
    text-align: center;
  }

  .newsletter-cta__heading {
    font-size: var(--text-lg);
    color: var(--color-ink);
  }

  .newsletter-cta__lead {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
  }

  .newsletter-cta__form {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .newsletter-cta__form[hidden] {
    display: none;
  }

  .newsletter-cta__input {
    flex: 1 1 240px;
    max-width: 320px;
    padding: var(--space-3) var(--space-4);
    border: var(--border-thin);
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: var(--text-sm);
  }

  .newsletter-cta__submit {
    padding: var(--space-3) var(--space-5);
    background: var(--color-cta);
    color: var(--color-cta-text);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .newsletter-cta__submit:hover {
    opacity: 0.92;
  }

  .newsletter-cta__message {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
  }
</style>

<script is:inline data-astro-rerun>
  // data-astro-rerun: View Transitions遷移後も結果表示ロジックを再実行するために必須
  (function () {
    const sections = document.querySelectorAll('[data-newsletter]');
    if (sections.length === 0) return;

    const params = new URLSearchParams(window.location.search);
    const result = params.get('newsletter');
    if (!result) return;

    const MESSAGES = {
      success: '登録ありがとうございます。確認のメールが届きますので、ご確認ください。',
      already: 'このメールアドレスは既に登録済みです。',
      error: '登録に失敗しました。お手数ですが、時間をおいて再度お試しください。',
    };
    const text = MESSAGES[result];
    if (!text) return;

    for (const section of sections) {
      const form = section.querySelector('[data-newsletter-form]');
      const message = section.querySelector('[data-newsletter-message]');
      if (!message) continue;

      message.textContent = text;
      message.hidden = false;
      if (form && result !== 'error') {
        form.hidden = true;
      }
    }

    // 同じ結果がリロード・共有のたびに再表示されないようURLからクエリを除去する
    params.delete('newsletter');
    const newSearch = params.toString();
    const newUrl = window.location.pathname + (newSearch ? '?' + newSearch : '') + window.location.hash;
    window.history.replaceState(null, '', newUrl);
  })();
</script>
