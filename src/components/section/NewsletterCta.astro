---
/**
 * NewsletterCta — 26章c24(00章P-12・12章§6からV3で繰り延べ実装)
 * Buttondownの静的フォーム埋め込み。外部JSは一切読み込まない(CSP的に外部
 * スクリプトゼロを維持)。送信先はButtondownの英語UIの確認画面だが、それを
 * そのまま訪問者に見せる(target="_blank"で別タブに開く)と、サイトが日本語
 * なのに突然英語の画面に切り替わって驚かれるため、非表示のiframeへ送信し、
 * 実際のページ遷移をさせずにフォームを日本語の完了メッセージへ置き換える
 * (第一者インラインスクリプトのみで完結・外部ライブラリ不使用)。
 * newsletterUrl(site.jsonのButtondown埋め込みaction URL)が未設定の場合は
 * 何も描画しない(Astro側でセクションごと出し分ける)。
 * Props: actionUrl(例: https://buttondown.email/api/emails/embed-subscribe/{username})
 */
interface Props {
  actionUrl: string;
}

const { actionUrl } = Astro.props;
---

<section class="newsletter-cta" data-newsletter>
  <div class="container-text newsletter-cta__inner">
    <p class="newsletter-cta__heading">メールでも、少しだけ。</p>
    <p class="newsletter-cta__lead">新しい記事やおすすめ商品を、月に数回ほどメールでお届けします。</p>
    <form action={actionUrl} method="post" target="newsletter-cta-frame" class="newsletter-cta__form" data-newsletter-form>
      <label for="newsletter-email" class="visually-hidden">メールアドレス</label>
      <input type="email" name="email" id="newsletter-email" placeholder="メールアドレス" required class="newsletter-cta__input" />
      <input type="hidden" value="1" name="embed" />
      <button type="submit" class="newsletter-cta__submit">登録する</button>
    </form>
    <p class="newsletter-cta__success" data-newsletter-success hidden aria-live="polite">
      登録ありがとうございます。確認のメールが届きますので、ご確認ください。
    </p>
    <iframe name="newsletter-cta-frame" class="visually-hidden" title="ニュースレター登録処理用(非表示)" tabindex="-1"></iframe>
  </div>
</section>

<style>
  .container-text {
    max-width: var(--container-text);
    margin-inline: auto;
    padding-inline: var(--outer-margin-mobile);
  }

  @media (min-width: 768px) {
    .container-text {
      padding-inline: var(--outer-margin);
    }
  }

  .newsletter-cta {
    padding-block: var(--space-7);
    text-align: center;
  }

  .newsletter-cta__heading {
    font-size: var(--text-lg);
    color: var(--color-ink);
  }

  .newsletter-cta__lead {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
  }

  .newsletter-cta__form {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .newsletter-cta__form[hidden] {
    display: none;
  }

  .newsletter-cta__input {
    flex: 1 1 240px;
    max-width: 320px;
    padding: var(--space-3) var(--space-4);
    border: var(--border-thin);
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: var(--text-sm);
  }

  .newsletter-cta__submit {
    padding: var(--space-3) var(--space-5);
    background: var(--color-cta);
    color: var(--color-cta-text);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .newsletter-cta__submit:hover {
    opacity: 0.92;
  }

  .newsletter-cta__success {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
  }
</style>

<script is:inline data-astro-rerun>
  // data-astro-rerun: View Transitions遷移後もフォームへ再アタッチするために必須
  (function () {
    const sections = document.querySelectorAll('[data-newsletter]');

    for (const section of sections) {
      const form = section.querySelector('[data-newsletter-form]');
      const success = section.querySelector('[data-newsletter-success]');
      if (!form || !success) continue;

      form.addEventListener('submit', () => {
        // 実際の送信は非表示iframeへのフォームPOSTに任せる(このイベント自体は
        // 標準のHTML5バリデーション通過後にのみ発火するため、ここに到達した
        // 時点でメールアドレスの形式は妥当と判断してよい)。
        form.hidden = true;
        success.hidden = false;
      });
    }
  })();
</script>
